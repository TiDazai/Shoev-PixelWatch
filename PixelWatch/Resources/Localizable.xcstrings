          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения и текст обрабатываются локально в памяти. Нет записи звука, облака, телеметрии и сохранения снимков. Сохраняются только правила, настройки и текст событий."
          }
        }
      }
